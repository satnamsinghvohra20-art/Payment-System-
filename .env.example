# SplitPay Enterprise Environment Variables

PORT=3000
NODE_ENV=production

# Active Gateway Provider: 'sandbox' | 'cashfree' | 'razorpay' | 'direct_bank'
PAYMENT_GATEWAY_DEFAULT=sandbox

# Cashfree Easy Split Credentials (Optional - can also configure via UI)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Razorpay Route Credentials (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Direct Bank Connected Banking (ICICI / HDFC API)
BANK_CORP_ID=
BANK_API_KEY=

# SaaS Stripe / Razorpay Subscription Plan ID
SPLITPAY_SAAS_PLAN_STARTER=plan_starter_499
SPLITPAY_SAAS_PLAN_PRO=plan_pro_999
